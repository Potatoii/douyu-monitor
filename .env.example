# 直播间 ID，逗号分隔，支持多个，如: 288016,4121481
ROOMS=

# PostgreSQL 连接串
DB_DSN=postgresql://douyu:douyu@localhost:5432/douyu_monitor

# 日志目录与保留天数
LOG_DIR=logs
LOG_RETENTION_DAYS=7

# 心跳间隔/超时（秒）
HEARTBEAT_INTERVAL=45
HEARTBEAT_TIMEOUT=90

# 去重缓存容量
DEDUP_MAX_SIZE=200000

# 批量写入参数
BATCH_SIZE=50
FLUSH_INTERVAL=2.0
